# ==============================================================================
# DORA Global Research — Environment Configuration Guide
# ==============================================================================

# 1. Supabase PostgreSQL Configuration
# (Obtain these from your Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Public Contact Details
# (Configurable email address displayed across the website headers, footer & contact desks)
NEXT_PUBLIC_CONTACT_EMAIL=contact@doraglobalresearch.com

# 3. Canonical Website URL
# (Used for canonical link headers, XML sitemap generation, and OpenGraph social previews)
NEXT_PUBLIC_SITE_URL=https://doraglobalresearch.com

# 4. Preview / Demo Mode
# (Set to "true" only if previewing locally without live Supabase database connected)
# DEMO_MODE=false
